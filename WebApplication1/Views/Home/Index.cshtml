@{
    ViewData["Title"] = Model?.Film_id > 0 ? "Редактирование фильма" : "Добавление фильма";
}
@model WebApplication1.Models.Film

<div class="text-center">
    <h1 class="display-4">Привет!</h1>
    <p>Здесь ты можешь добавить фильм на свое усмотрение:)</p>
</div>

<div class="add-movie">
    <form method="post">
        <input type="hidden" asp-for="Film_id"/>
        <input type="text" asp-for="Title" placeholder="Название..." required />
        <input type="text" asp-for="Description" placeholder="Описание..." required />
        <input type="text" asp-for="Country" placeholder="Страна..." required />
        <input type="number" asp-for="Release_Year" placeholder="Год..." required />
        <input type="text" asp-for="Genre" placeholder="Жанр..." required />
        <input type="text" asp-for="Language" placeholder="Язык..." required />
        <input type="text" asp-for="Director" placeholder="Режиссер..." required />
        <input type="number" asp-for="Rating" step="0.1" placeholder="Оценка (1.0 - 10.0)..." required min="1.0" max="10.0" />
        <input type="url" asp-for="Poster_Url" placeholder="Url Poster..." required />

        <button type="submit" class="submit-btn">@(Model?.Film_id > 0?"Изменить" : "Добавить")</button>
    </form>
</div>